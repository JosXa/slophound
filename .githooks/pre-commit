#!/bin/sh
# Lint every staged Markdown file with slophound before it lands.
# The repo dogfoods its own linter: if slophound flags this repo's prose, the commit stops.
# Enable once per clone: git config core.hooksPath .githooks
set -eu

# The test corpus is deliberately full of findings; the test runner owns it.
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md' ':!tests/corpus/**')
[ -n "$files" ] || exit 0

root=$(git rev-parse --show-toplevel)
# shellcheck disable=SC2086
exec "$root/slophound" $files
